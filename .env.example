# Modelo. O projeto já vem configurado em .env.production e .env.development;
# use ".env.local" só para apontar o app para outro projeto Supabase.
# Essas duas chaves são públicas: podem ficar no app. A chave "service_role" NUNCA vai aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-public-aqui

# Domínio de e-mail aceito no cadastro
VITE_EMAIL_DOMAIN=isecensa.edu.br
